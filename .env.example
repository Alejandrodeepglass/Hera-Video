# Copiar a .env y cargar en el servidor. Nunca subir .env a Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Opcional: sin valor, se genera data/admin-password (0600).
STUDIO_PASSWORD=
HOST=127.0.0.1
PORT=3000
CHROME_PATH=/usr/bin/chromium
# Solo detrás de un proxy HTTPS de confianza:
# TRUST_PROXY=1
# COOKIE_SECURE=1
